{
  "schemaVersion": 1,
  "id": "bedrockpackloader",
  "version": "${version}",
  "name": "Bedrock Pack Loader",
  "description": "Use Minecraft Bedrock resource packs directly in Java Edition. Reads brarchive containers and translates Bedrock geometry and animations for GeckoLib.",
  "authors": ["kintil555"],
  "contact": {
    "sources": "https://github.com/kintil555/bepackloader"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.kintil555.bedrockpackloader.BedrockPackLoaderMod"]
  },
  "mixins": ["bedrockpackloader.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.152.1+26.2",
    "geckolib": ">=5.5.5",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
